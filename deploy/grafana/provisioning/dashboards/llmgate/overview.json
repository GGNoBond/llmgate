{
  "title": "LLMGate AI 网关总览",
  "uid": "llmgate-overview",
  "tags": ["llmgate", "ai-gateway"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "id": 1,
      "title": "QPS",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(llmgate_requests_total[$__rate_interval]))", "legendFormat": "QPS" }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "错误率 (5xx+429)",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.05 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(llmgate_requests_total{status=~\"5..|429\"}[$__rate_interval])) / sum(rate(llmgate_requests_total[$__rate_interval]))", "legendFormat": "错误率" }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "在途请求 (inflight)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "expr": "llmgate_inflight_requests", "legendFormat": "inflight" }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "故障转移 (5m)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(llmgate_failover_total[5m]))", "legendFormat": "failover" }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "请求延迟分位 (P50/P90/P99)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum(rate(llmgate_request_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "P50" },
        { "refId": "B", "expr": "histogram_quantile(0.9, sum(rate(llmgate_request_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "P90" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(llmgate_request_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "P99" }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "流式首包 TTFT (P50/P95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum(rate(llmgate_stream_ttft_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "TTFT P50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(llmgate_stream_ttft_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "TTFT P95" }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "缓存命中率",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(llmgate_cache_total{result=\"hit\"}[$__rate_interval])) / sum(rate(llmgate_cache_total[$__rate_interval]))", "legendFormat": "命中率" }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Token 吞吐 (按类型)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(llmgate_tokens_total[$__rate_interval])) by (type)", "legendFormat": "{{type}}" }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "限流拒绝 (按维度)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(llmgate_rate_limited_total[5m])) by (dim)", "legendFormat": "{{dim}}" }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "请求数 (按状态码)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(llmgate_requests_total[$__rate_interval])) by (status)", "legendFormat": "{{status}}" }
      ]
    }
  ]
}
